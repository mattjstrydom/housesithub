{
  "name": "housesithub",
  "main": "src/worker.js",
  "compatibility_date": "2026-11-25",
  "workers_dev": true,
  "preview_urls": true,
  "vars": {
    "SITE_ORIGIN": "https://www.housesithub.com",
    "EMAIL_FROM": "House Sit Hub <course@housesithub.com>",
    "STRIPE_PUBLISHABLE_KEY": "pk_live_51HAhpLAwP98eOwgG1E78ayeyJ3KXsHMYJ5EOu1UxYcGKRtxJCF4dCZmm72OKXoRb1bXxsEpHyH7WyKQCj047GrvA00jTqYYzSk"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "housesithub-lms",
      "database_id": "e9a8fde7-6576-420e-b99f-c5493138ba6e",
      "migrations_dir": "lms/migrations"
    }
  ],
  "r2_buckets": [
    { "binding": "COURSE_FILES", "bucket_name": "housesithub-course-files" }
  ],
  "assets": {
    "directory": "./",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page",
    "run_worker_first": ["/api/*", "/login", "/auth/*", "/course", "/course/*"]
  },
  "previews": {
    "vars": {
      "SITE_ORIGIN": "https://lms-housesithub.closedlogic.workers.dev",
      "EMAIL_FROM": "House Sit Hub <course@housesithub.com>"
    },
    "d1_databases": [
      {
        "binding": "DB",
        "database_name": "housesithub-lms-staging",
        "database_id": "57d89ee6-5d6b-4164-b06c-73abba81e626",
        "migrations_dir": "lms/migrations"
      }
    ],
    "r2_buckets": [
      { "binding": "COURSE_FILES", "bucket_name": "housesithub-course-files" }
    ]
  }
}
