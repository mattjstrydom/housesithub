{
  "name": "housesithub",
  "main": "src/worker.js",
  "compatibility_date": "2026-11-25",
  "workers_dev": true,
  "preview_urls": true,
  "assets": {
    "directory": "./",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page",
    "run_worker_first": ["/api/*"]
  }
}
